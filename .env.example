# Copy this file to .env and fill in the values.
# All three services share INFLUXDB_TOKEN — they must match exactly.

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme123!
INFLUXDB_ORG=pitlane
INFLUXDB_BUCKET=forza

# Choose any long random string — this becomes the InfluxDB admin API token.
# All three services use the same token, so update all three if you change it.
INFLUXDB_TOKEN=my-super-secret-pitlane-token-change-me

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=pitlane

# ── Collector ─────────────────────────────────────────────────────────────────
# UDP port that Forza sends data to. Set the same value in-game.
UDP_PORT=5300
